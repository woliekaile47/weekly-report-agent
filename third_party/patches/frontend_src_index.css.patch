--- upstream/frontend/src/index.css
+++ adapted/frontend/src/index.css
@@ -15,3 +15,237 @@
 .severity-info {
   @apply border-sky-300 bg-sky-50 text-sky-800;
 }
+
+@layer base {
+  html {
+    scroll-behavior: smooth;
+  }
+  body {
+    @apply m-0;
+  }
+  button,
+  a,
+  summary {
+    -webkit-tap-highlight-color: transparent;
+  }
+  button {
+    @apply cursor-pointer;
+  }
+  button:disabled {
+    @apply cursor-not-allowed opacity-50;
+  }
+  :focus-visible {
+    @apply outline outline-2 outline-offset-2 outline-brand-500;
+  }
+}
+
+@layer components {
+  .primary {
+    @apply inline-flex items-center justify-center rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 disabled:opacity-50;
+  }
+  .secondary {
+    @apply inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50;
+  }
+  .card {
+    @apply rounded-xl border border-slate-200 bg-white p-5;
+  }
+  .muted {
+    @apply text-sm leading-6 text-slate-500;
+  }
+  .error {
+    @apply rounded-md border border-rose-200 bg-rose-50 p-3 text-sm leading-6 text-rose-700;
+  }
+  .success {
+    @apply mb-4 rounded-md border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800;
+  }
+  form label {
+    @apply block text-sm text-slate-700;
+  }
+  form label > input:not([type="file"]),
+  form label > textarea,
+  form label > select {
+    @apply mt-1.5 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900;
+  }
+  form textarea {
+    @apply resize-y leading-6;
+  }
+  .upload {
+    @apply block;
+  }
+  .upload > span {
+    @apply mb-2 block;
+  }
+  .upload input {
+    @apply block w-full min-w-0 rounded-md border border-slate-300 bg-white p-2 text-sm text-slate-600;
+  }
+  .upload input::file-selector-button {
+    @apply mr-3 cursor-pointer rounded border border-slate-300 bg-slate-50 px-3 py-1.5 text-sm text-slate-700;
+  }
+  .upload small {
+    @apply mt-1 block text-xs text-slate-400;
+  }
+  .uploads {
+    @apply my-4 grid grid-cols-1 gap-4 sm:grid-cols-2;
+  }
+  .form-grid {
+    @apply my-4 grid grid-cols-1 gap-4 sm:grid-cols-3;
+  }
+  .table-wrap {
+    @apply w-full overflow-x-auto;
+  }
+  table {
+    @apply w-full border-collapse text-left text-sm;
+  }
+  th {
+    @apply whitespace-nowrap border-b border-slate-200 bg-slate-50 px-3 py-2 font-medium text-slate-500;
+  }
+  td {
+    @apply border-b border-slate-100 px-3 py-2.5 align-top leading-6 text-slate-700;
+  }
+  th:not(:first-child),
+  td:not(:first-child) {
+    font-variant-numeric: tabular-nums;
+  }
+  .negative {
+    @apply text-rose-600;
+  }
+  .results {
+    @apply min-w-0 space-y-4;
+  }
+  .tabs {
+    @apply flex flex-wrap gap-1 border-b border-slate-200 pb-2;
+  }
+  .tabs button {
+    @apply rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100;
+  }
+  .tabs button.selected {
+    @apply bg-brand-600 text-white;
+  }
+  .report-content {
+    @apply space-y-4 text-sm leading-7 text-slate-700;
+  }
+  .report-content h2 {
+    @apply mb-2 mt-6 text-base font-semibold text-slate-800;
+  }
+  .report-content h2:first-child {
+    @apply mt-0;
+  }
+  .report-content h3 {
+    @apply mb-2 font-semibold text-slate-800;
+  }
+  .report-content ul {
+    @apply list-disc space-y-2 pl-5;
+  }
+  .section-heading {
+    @apply flex flex-wrap items-center justify-between gap-2;
+  }
+  .section-heading h2 {
+    @apply m-0;
+  }
+  .tag {
+    @apply inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600;
+  }
+  .finding {
+    @apply border-b border-slate-100 py-3;
+  }
+  .finding h3 .tag {
+    @apply ml-3;
+  }
+  blockquote {
+    @apply mt-2 border-l-2 border-slate-200 bg-slate-50 px-3 py-2 text-xs leading-6 text-slate-500;
+  }
+  .conflict {
+    @apply rounded-md border border-amber-200 bg-amber-50 p-3 text-sm leading-6 text-amber-900;
+  }
+  .download-row {
+    @apply mt-5 flex flex-wrap gap-3;
+  }
+  .empty {
+    @apply rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm leading-6 text-slate-500;
+  }
+  .empty h3 {
+    @apply mb-2 font-semibold text-slate-700;
+  }
+  .notice {
+    @apply mb-5 rounded-xl border border-amber-300 bg-amber-50 p-5 text-sm leading-6 text-amber-900;
+  }
+  .notice p {
+    @apply my-2;
+  }
+  .notice form {
+    @apply mt-3;
+  }
+  .notice form > button {
+    @apply mr-3 mt-4;
+  }
+  .notice details {
+    @apply mb-3;
+  }
+  summary {
+    @apply cursor-pointer;
+  }
+  .running-strip {
+    @apply rounded-md border border-brand-200 bg-brand-50 p-3 text-sm text-brand-800;
+  }
+  .review {
+    @apply space-y-3 text-sm leading-6;
+  }
+  .review h2 {
+    @apply text-sm font-semibold;
+  }
+  .review .uploads {
+    @apply my-3;
+  }
+  .review .muted {
+    @apply text-amber-900;
+  }
+  .check {
+    @apply flex gap-3 border-b border-slate-100 py-3 text-sm;
+  }
+  .check p {
+    @apply mt-1 text-xs leading-6 text-slate-500;
+  }
+  .pass {
+    @apply font-semibold text-emerald-600;
+  }
+  .fail {
+    @apply font-semibold text-rose-600;
+  }
+  .event {
+    @apply border-b border-slate-100 py-3 text-sm text-slate-600;
+  }
+  .event time {
+    @apply mr-3 font-mono text-xs text-slate-400;
+  }
+  pre {
+    @apply mt-3 max-h-96 overflow-auto rounded-md bg-slate-50 p-3 font-mono text-xs leading-6;
+  }
+  .config-page > .card,
+  .config-page form > .card {
+    @apply mb-4;
+  }
+  .config-page h2:not(:first-child),
+  .config-page .card > h2 {
+    @apply mb-2 text-sm font-semibold text-slate-700;
+  }
+  .config-page .card > label {
+    @apply mb-4;
+  }
+  .config-page .card > p {
+    @apply mb-4 text-sm leading-6 text-slate-600;
+  }
+  .config-page form > p {
+    @apply mb-4;
+  }
+  .config-page small {
+    @apply font-mono text-xs text-slate-400;
+  }
+  .config-page textarea.code-editor {
+    @apply mt-3 block w-full rounded-md border border-slate-300 bg-slate-50 p-3 font-mono text-xs leading-6;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+}
